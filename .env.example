# Formspree Contact Form Integration (Optional)
# 1. Sign up at https://formspree.io
# 2. Create a new form and copy your Form ID (e.g. "mqkvnlep")
# 3. Rename this file to .env.local and insert your Form ID below:

VITE_FORMSPREE_KEY=
# or full URL:
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
